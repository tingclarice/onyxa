
# Auth.js (generate AUTH_SECRET with a cryptographically random 32+ byte value)
AUTH_SECRET=
# Set this to the application's public origin in production.
AUTH_URL=http://localhost:3000

# Supabase Data API used by the app
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SECRET_KEY=
# PostgreSQL connection used by Prisma migrations
DATABASE_URL="postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres"

# Cloudinary unsigned image upload. NEXT_PUBLIC_ aliases are also supported.
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_UPLOAD_PRESET=xxx

# Gemini API
GEMINI_API_KEY=xxx
