generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Application accounts use Auth.js Credentials. Supabase hosts PostgreSQL only.

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  name                String    @db.VarChar(100)
  profileImageUrl     String?
  passwordHash        String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  loginVersion        Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  memberships BusinessMember[]
}

enum BusinessType {
  CAFE_RESTAURANT
  STORE
  OTHER
}

enum MemberRole {
  OWNER
  STAFF
}

enum BaseUnit {
  KG
  LITER
  PCS
}

enum ReceiptStatus {
  NEEDS_REVIEW
  SAVED
}

enum ExpenseCategory {
  COGS
  OPEX
  CAPEX
}

enum StockSnapshotSource {
  INLINE_RESTOCK
  STANDALONE_OPNAME
}

model Business {
  id                            String       @id @default(uuid()) @db.Uuid
  name                          String
  profileImageUrl               String?
  businessType                  BusinessType @default(OTHER)
  priceIncreaseThresholdPercent Decimal      @default(5) @db.Decimal(5, 2)
  priceIncreaseAlertsEnabled    Boolean      @default(true)
  slowMovingAlertsEnabled       Boolean      @default(true)
  // Melambat is shown only when a restock is late by more than this % of the expected time.
  slowMovingGracePercent        Int          @default(20)
  createdAt                     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime     @updatedAt @db.Timestamptz(3)

  members      BusinessMember[]
  invitations  BusinessInvitation[]
  suppliers    Supplier[]
  items        Item[]
  aliases      ItemAlias[]
  receipts       Receipt[]
  receiptLines   ReceiptLine[]
  stockSnapshots StockSnapshot[]
  settlements    IncomeSettlement[]
}

model BusinessMember {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @db.Uuid
  userId     String     @db.Uuid
  email      String     @db.VarChar(254)
  role       MemberRole @default(STAFF)
  removedAt  DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations BusinessInvitation[]
  receipts       Receipt[]
  scanDrafts     ReceiptDraft[]
  stockSnapshots StockSnapshot[]
  settlements    IncomeSettlement[]

  @@unique([businessId, id])
  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessInvitation {
  id                String     @id @default(uuid()) @db.Uuid
  businessId        String     @db.Uuid
  invitedByMemberId String     @db.Uuid
  email             String     @db.VarChar(254)
  emailKey          String     @db.VarChar(254)
  role              MemberRole @default(STAFF)
  expiresAt         DateTime   @db.Timestamptz(3)
  acceptedAt        DateTime?  @db.Timestamptz(3)
  revokedAt         DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invitedBy BusinessMember @relation(fields: [businessId, invitedByMemberId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, emailKey])
  @@index([emailKey])
  @@index([businessId, invitedByMemberId])
  @@index([expiresAt])
}

model Supplier {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  nameKey    String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  receipts Receipt[]

  @@unique([businessId, id])
  @@unique([businessId, nameKey])
}

model Item {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  nameKey    String
  baseUnit   BaseUnit
  category String? @db.VarChar(80)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  aliases        ItemAlias[]
  receiptLines   ReceiptLine[]
  stockSnapshots StockSnapshot[]

  @@unique([businessId, id])
  @@unique([businessId, nameKey])
}

model ItemAlias {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  itemId     String   @db.Uuid
  name       String
  nameKey    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  item     Item     @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, nameKey])
  @@index([businessId, itemId])
}

model IncomeSettlement {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  memberId   String   @db.Uuid
  date       DateTime @db.Date
  cash       Decimal  @db.Decimal(18, 2)
  qris       Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  member BusinessMember @relation(fields: [businessId, memberId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, date])
}

model ReceiptDraft {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  memberId   String   @db.Uuid
  sourceKey  String   @db.Char(64)
  imageUrl   String
  name       String
  extraction Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  uploader BusinessMember @relation(fields: [businessId, memberId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, memberId, sourceKey])
  @@index([businessId, memberId, createdAt])
}

model Receipt {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @db.Uuid
  createdByMemberId String        @db.Uuid
  supplierId        String?       @db.Uuid
  supplierName      String
  receiptDate       DateTime      @db.Date
  status            ReceiptStatus @default(NEEDS_REVIEW)
  total             Decimal       @db.Decimal(18, 2)
  discount          Decimal       @default(0) @db.Decimal(18, 2)
  overallConfidence Decimal?      @db.Decimal(4, 3)
  imageUrl          String?
  imageSha256       String?       @db.Char(64)
  confirmedAt       DateTime?     @db.Timestamptz(3)
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMember @relation(fields: [businessId, createdByMemberId], references: [businessId, id], onDelete: Restrict)
  supplier  Supplier?      @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  lines     ReceiptLine[]

  @@unique([businessId, id])
  @@index([businessId, receiptDate])
  @@index([businessId, status, receiptDate])
  @@index([businessId, supplierId, receiptDate])
  @@index([businessId, createdByMemberId])
  @@index([businessId, imageSha256])
}

model ReceiptLine {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  receiptId       String           @db.Uuid
  itemId          String?          @db.Uuid
  position        Int
  rawName         String
  quantity        Decimal          @db.Decimal(18, 6)
  unit            String
  unitPrice       Decimal          @db.Decimal(18, 2)
  lineTotal       Decimal          @db.Decimal(18, 2)
  discount        Decimal          @default(0) @db.Decimal(18, 2)
  confidence      Decimal?         @db.Decimal(4, 3)
  expenseCategory ExpenseCategory?
  baseQuantity    Decimal?         @db.Decimal(18, 6)
  baseUnit        BaseUnit?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  receipt       Receipt        @relation(fields: [businessId, receiptId], references: [businessId, id], onDelete: Cascade)
  item          Item?          @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Restrict)
  stockSnapshot StockSnapshot?

  @@unique([businessId, receiptId, position])
  @@index([businessId, itemId, receiptId])
}

model StockSnapshot {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  itemId             String              @db.Uuid
  recordedByMemberId String              @db.Uuid
  source             StockSnapshotSource
  receiptLineId      String?             @unique @db.Uuid
  countedQty         Decimal             @db.Decimal(18, 6)
  postEventStock     Decimal             @db.Decimal(18, 6)
  recordedAt         DateTime            @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  item        Item           @relation(fields: [businessId, itemId], references: [businessId, id], onDelete: Cascade)
  recordedBy  BusinessMember @relation(fields: [businessId, recordedByMemberId], references: [businessId, id], onDelete: Restrict)
  receiptLine ReceiptLine?   @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptLineId])
  @@index([businessId, itemId, recordedAt])
}
